<Window x:Class="EventCameraUdpViewer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DVSLume 20路UDP事件相机上位机"
        Width="1280" Height="720" MinWidth="1024" MinHeight="600"
        Background="#101318" Foreground="White"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing"
        KeyDown="MainWindow_KeyDown">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="20 路 UDP 控制" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="UEVT V2 · 10组 × 宽/窄视场"
                                   Foreground="#91A0B4" Margin="0,2,0,8" />

                        <TextBlock Text="绑定地址" />
                        <TextBox x:Name="BindAddressTextBox" Text="0.0.0.0" />
                        <TextBlock Text="起始端口" />
                        <TextBox x:Name="BasePortTextBox" Text="50000" />
                        <Button x:Name="ApplyNetworkButton" Content="应用UDP端口映射"
                                Click="ApplyNetworkButton_Click" />

                        <UniformGrid Columns="2" Margin="0,3,0,0">
                            <Button x:Name="StartAllButton" Content="全部监听"
                                    Margin="0,5,3,0" Click="StartAllButton_Click" />
                            <Button x:Name="StopAllButton" Content="全部停止"
                                    Margin="3,5,0,0" Background="#9A3D42"
                                    Click="StopAllButton_Click" />
                        </UniformGrid>
                        <TextBlock x:Name="RunningCountTextBlock" Text="监听：0 / 20"
                                   Foreground="#AEB7C3" Margin="0,8,0,0" />

                        <TextBlock Text="显示设置" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="分辨率" Foreground="#AEB7C3" />
                                <ComboBox x:Name="ResolutionComboBox"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="DisplaySettingsComboBox_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="帧率" Foreground="#AEB7C3" />
                                <ComboBox x:Name="FrameRateComboBox"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="DisplaySettingsComboBox_SelectionChanged" />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,8" Background="#3B414B" />
                        <TextBlock Text="选择窗口" FontSize="16" FontWeight="SemiBold" />
                        <ComboBox x:Name="SlotComboBox"
                                  SelectionChanged="SlotComboBox_SelectionChanged" />
                        <TextBlock x:Name="CurrentPortTextBlock" Text="UDP 0.0.0.0:50000"
                                   Foreground="#9BC8FF" Margin="0,2,0,3" />
                        <TextBlock Text="画面内容" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <ComboBox x:Name="DisplayContentComboBox"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="DisplayContentComboBox_SelectionChanged" />
                        <UniformGrid Columns="2">
                            <Button x:Name="StartSelectedButton" Content="监听当前"
                                    Margin="0,5,3,0" Click="StartSelectedButton_Click" />
                            <Button x:Name="StopSelectedButton" Content="停止当前"
                                    Margin="3,5,0,0" Background="#9A3D42"
                                    Click="StopSelectedButton_Click" />
                        </UniformGrid>

                        <Border Margin="0,10,0,0" Padding="10" Background="#15181D"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="SelectedStatusTextBlock" TextWrapping="Wrap"
                                       FontFamily="Consolas" Text="未监听" />
                        </Border>
                        <TextBlock Margin="0,10,0,0" Foreground="#8995A7" TextWrapping="Wrap"
                                   Text="每组使用一个UDP端口，camera_id=1/2对应宽/窄视场。画面内容只改变本机显示；单击画面可放大，再次单击或按Esc返回。" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="#15181D"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="UDP 实时总览" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="HeaderStatusTextBlock" Text="等待数据"
                                   Foreground="#91A0B4" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid x:Name="OverviewGrid" />
                        <Border x:Name="FocusBorder" Visibility="Collapsed"
                                Background="#1C1C1C" BorderBrush="#2E78D2"
                                BorderThickness="2" MouseLeftButtonUp="FocusBorder_MouseLeftButtonUp">
                            <Grid>
                                <Image x:Name="FocusImage" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border VerticalAlignment="Top" Background="#AA101318" Padding="10,5">
                                    <TextBlock x:Name="FocusTitleTextBlock" FontSize="18" FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="1" x:Name="MessageTextBlock" Text="正在初始化UDP核心…"
                   Foreground="#AEB7C3" VerticalAlignment="Center" Margin="4,0" />
    </Grid>
</Window>
