<Application x:Class="EventCameraUdpViewer.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#20242B" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3B414B" />
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#2E78D2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3,0,6" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="#15181D" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3,0,6" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Application.Resources>
</Application>
