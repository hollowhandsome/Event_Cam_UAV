<Window x:Class="EventCameraViewer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DVSLume 20 路事件相机上位机"
        Width="1280" Height="720" MinWidth="1024" MinHeight="600"
        Background="#111318" Foreground="#E9EDF2"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Grid x:Name="MainLayout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ControlPanel" Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="20 路相机控制" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="10 组 × 宽/窄视场" Foreground="#96A0AE"
                                   Margin="0,2,0,10" />

                        <Button x:Name="RefreshButton" Content="刷新相机并自动分配"
                                Click="RefreshButton_Click" />
                        <UniformGrid Columns="2">
                            <Button x:Name="StartAllButton" Content="全部启动"
                                    Margin="0,5,3,0" Click="StartAllButton_Click" />
                            <Button x:Name="StopAllButton" Content="全部停止"
                                    Margin="3,5,0,0" Background="#9A3D42"
                                    Click="StopAllButton_Click" />
                        </UniformGrid>
                        <TextBlock x:Name="CameraCountTextBlock" Text="已发现：0 / 20"
                                   Foreground="#AEB7C3" Margin="0,8,0,0" />

                        <Separator Margin="0,10,0,8" Background="#3B414B" />
                        <TextBlock Text="当前槽位" FontSize="16" FontWeight="SemiBold" />
                        <ComboBox x:Name="SlotComboBox"
                                  SelectionChanged="SlotComboBox_SelectionChanged" />

                        <TextBlock Text="分配相机" />
                        <ComboBox x:Name="CameraComboBox" DisplayMemberPath="DisplayName"
                                  SelectionChanged="CameraComboBox_SelectionChanged" />
                        <Button Content="清除此槽位的分配" Background="#505661"
                                Click="ClearAssignmentButton_Click" />

                        <TextBlock Text="bias_diff_off" Margin="0,8,0,0" />
                        <TextBox x:Name="BiasOffTextBox" Text="90" />
                        <TextBlock Text="bias_diff_on" />
                        <TextBox x:Name="BiasOnTextBox" Text="45" />
                        <Button x:Name="ApplyBiasButton" Content="应用当前槽位 Bias"
                                Click="ApplyBiasButton_Click" />

                        <UniformGrid Columns="2">
                            <Button x:Name="StartSelectedButton" Content="启动当前"
                                    Margin="0,5,3,0" Click="StartSelectedButton_Click" />
                            <Button x:Name="StopSelectedButton" Content="停止当前"
                                    Margin="3,5,0,0" Background="#9A3D42"
                                    Click="StopSelectedButton_Click" />
                        </UniformGrid>

                        <Border Margin="0,10,0,0" Padding="8" Background="#15181D"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="当前槽位状态" FontWeight="SemiBold" />
                                <TextBlock x:Name="StateTextBlock" Text="未启动"
                                           Foreground="#F1C75B" Margin="0,6,0,0" />
                                <TextBlock x:Name="SerialTextBlock" Text="序列号：未分配"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="EventRateTextBlock" Text="事件率：0 events/s" />
                                <TextBlock x:Name="TotalEventsTextBlock" Text="累计事件：0" />
                                <TextBlock x:Name="FrameIdTextBlock" Text="画面编号：0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,8,0,0" Foreground="#7F8995"
                                   TextWrapping="Wrap"
                                   Text="单击任一画面可放大占满显示区；再次单击或按 Esc 返回总览。" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="OverviewPanel" Grid.Column="2" Background="#181B20"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="实时总览" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="5,0" />
                        <TextBlock x:Name="RunningCountTextBlock" Text="运行：0 / 20"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="#96A0AE" Margin="0,0,6,0" />
                    </Grid>
                    <Grid x:Name="OverviewGrid" Grid.Row="1" />
                </Grid>
            </Border>

            <Grid x:Name="FocusView" Grid.ColumnSpan="3" Panel.ZIndex="20"
                  Background="#0C0E11" Visibility="Collapsed">
                <Image x:Name="FocusImage" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       MouseLeftButtonDown="FocusImage_MouseLeftButtonDown" />
                <Border VerticalAlignment="Top" Background="#CC15181D" Padding="12">
                    <Grid>
                        <TextBlock x:Name="FocusTitleTextBlock" FontSize="20"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="返回总览  Esc" HorizontalAlignment="Right"
                                Margin="0" Click="BackToOverviewButton_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="StatusBar" Grid.Row="1" Background="#CC111318">
            <TextBlock x:Name="MessageTextBlock" Text="正在初始化…"
                       VerticalAlignment="Center" Margin="8,0" Foreground="#AEB7C3"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
